# ==============================================================================
# TRUTHLENS AI - ENVIRONMENT CONFIGURATION (.env.example)
# ==============================================================================

# ------------------------------------------------------------------------------
# 1. KIE.AI CONFIGURATION (MANDATORY LLM PROVIDER)
# ------------------------------------------------------------------------------
# KIE_API_KEY: Your KIE.ai API secret key for LLM claim extraction & reasoning.
# Keep this private on the backend. Never expose to client/browser.
KIE_API_KEY=""

# KIE_BASE_URL: Base URL for KIE.ai API endpoints.
# Defaults to https://api.kie.ai/v1 if left empty.
KIE_BASE_URL="https://api.kie.ai/v1"

# KIE_MODEL: Default model alias for KIE.ai inference.
# Configurable. Default: gemini-3-8-flash-openai
KIE_MODEL="gemini-3-8-flash-openai"

# ------------------------------------------------------------------------------
# 2. WEB RESEARCH INTEGRATIONS
# ------------------------------------------------------------------------------
# TAVILY_API_KEY: Tavily Search API key for real-time web research & source collection.
# If omitted, the engine employs direct public web news search fallbacks with transparent status.
TAVILY_API_KEY=""

# GOOGLE_FACT_CHECK_API_KEY: Google Fact Check Tools API key (optional).
# Queries existing claims from verified fact-checking organizations.
GOOGLE_FACT_CHECK_API_KEY=""

# ------------------------------------------------------------------------------
# 3. DATABASE CONFIGURATION (OPTIONAL / SUPABASE)
# ------------------------------------------------------------------------------
# SUPABASE_URL: Supabase Project REST URL.
# If omitted, TruthLens AI uses structured in-memory / local storage persistence.
SUPABASE_URL=""

# SUPABASE_SERVICE_ROLE_KEY: Supabase secret service role key (Backend only).
SUPABASE_SERVICE_ROLE_KEY=""

# ------------------------------------------------------------------------------
# 4. SERVER & NETWORK CONFIGURATION
# ------------------------------------------------------------------------------
PORT="3000"
NODE_ENV="development"
